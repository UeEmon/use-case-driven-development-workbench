# 公開ポート（他サービスと衝突する場合に変更）
DOCS_PORT=8000
PLANTUML_PORT=8080
DRAWIO_PORT=8081

# ポートを受け付けるアドレス
#   127.0.0.1 : この Mac からだけ接続できる（既定・推奨）
#   0.0.0.0   : 同じ Wi-Fi/LAN の他の端末からも接続できる（認証がないので自宅 LAN 内に限る）
BIND_ADDRESS=127.0.0.1

# Cloudflare Tunnel を使う場合のみ（make cloudflare-setup が自動で書き込む。docs/guide/remote-access.md 参照）
# このファイルは .gitignore 済み。トークンは絶対にコミットしない
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_HOSTNAME=
